# ─── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME="NextJS AI Starter Kit"

# ─── Auth (NextAuth.js v5) ──────────────────────────
AUTH_SECRET=your-auth-secret-at-least-32-chars-long
AUTH_URL=http://localhost:3000

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── OpenAI ─────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_ORG_ID=
# Optional: Azure OpenAI
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Comma-separated list of enabled models (first = default)
OPENAI_ENABLED_MODELS=gpt-4o,gpt-4o-mini,gpt-4-turbo,gpt-3.5-turbo

# ─── Database (PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_starter_kit
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ai_starter_kit

# ─── Redis (for rate-limiting) ─────────────────────
REDIS_URL=redis://localhost:6379

# ─── Stripe ─────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Price IDs from Stripe Dashboard
STRIPE_PRICE_MONTHLY=price_monthly_id
STRIPE_PRICE_YEARLY=price_yearly_id

# ─── Rate Limiting ──────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
