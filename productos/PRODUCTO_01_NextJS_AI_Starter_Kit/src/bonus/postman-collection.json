{
  "info": {
    "name": "NextJS AI Starter Kit API",
    "description": "Complete API collection for the NextJS AI Starter Kit. Includes authentication, chat, and subscription endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "ai-starter-kit"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign In with GitHub",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/signin/github",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "signin", "github"]
            }
          }
        },
        {
          "name": "Sign In with Google",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/signin/google",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "signin", "google"]
            }
          }
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "next-auth.session-token={{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/session",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "session"]
            }
          }
        },
        {
          "name": "Sign Out",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/signout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "signout"]
            }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Send Message (Streaming)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "next-auth.session-token={{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a helpful AI assistant.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a hello world function in TypeScript.\"\n    }\n  ],\n  \"model\": \"gpt-4o-mini\",\n  \"temperature\": 0.7,\n  \"maxTokens\": 1024\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/chat",
              "host": ["{{base_url}}"],
              "path": ["api", "chat"]
            }
          }
        },
        {
          "name": "Get Chat History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "next-auth.session-token={{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/chat",
              "host": ["{{base_url}}"],
              "path": ["api", "chat"]
            }
          }
        },
        {
          "name": "Get Chat by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "next-auth.session-token={{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/chat?chatId=CHAT_ID_HERE",
              "host": ["{{base_url}}"],
              "path": ["api", "chat"],
              "query": [
                {
                  "key": "chatId",
                  "value": "CHAT_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Chat",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "next-auth.session-token={{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/chat?chatId=CHAT_ID_HERE",
              "host": ["{{base_url}}"],
              "path": ["api", "chat"],
              "query": [
                {
                  "key": "chatId",
                  "value": "CHAT_ID_HERE"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Stripe",
      "item": [
        {
          "name": "Create Checkout Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "next-auth.session-token={{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priceId\": \"price_monthly_id\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/stripe/checkout",
              "host": ["{{base_url}}"],
              "path": ["api", "stripe", "checkout"]
            }
          }
        },
        {
          "name": "Stripe Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Stripe-Signature",
                "value": "{{stripe_signature}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"checkout.session.completed\",\n  \"data\": {\n    \"object\": {\n      \"customer\": \"cus_example\",\n      \"subscription\": \"sub_example\",\n      \"metadata\": {\n        \"priceId\": \"price_monthly_id\"\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/stripe/webhook",
              "host": ["{{base_url}}"],
              "path": ["api", "stripe", "webhook"]
            }
          }
        }
      ]
    },
    {
      "name": "Pages",
      "item": [
        {
          "name": "Landing Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            }
          }
        },
        {
          "name": "Chat Interface",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/chat",
              "host": ["{{base_url}}"],
              "path": ["chat"]
            }
          }
        },
        {
          "name": "Login Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Pricing Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pricing",
              "host": ["{{base_url}}"],
              "path": ["pricing"]
            }
          }
        }
      ]
    }
  ]
}
