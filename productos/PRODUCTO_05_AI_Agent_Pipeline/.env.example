# ── AI Provider API Keys (at least one required) ──────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ── Pipeline Configuration ─────────────────────────────────────────────────
PIPELINE_CONFIG_PATH=config.yml
PIPELINE_DEFAULT_PROVIDER=openai
PIPELINE_AGENT__HUMAN_IN_THE_LOOP=true
PIPELINE_AGENT__MAX_RETRIES=3

# ── Memory / Redis ─────────────────────────────────────────────────────────
PIPELINE_MEMORY__BACKEND=redis
PIPELINE_MEMORY__REDIS_URL=redis://localhost:6379/0
PIPELINE_MEMORY__TTL_SECONDS=3600

# ── API Server ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_RELOAD=false

# ── Logging ────────────────────────────────────────────────────────────────
PIPELINE_LOGGING__LEVEL=INFO
