# ============================================
# RAG System Template - Environment Variables
# ============================================

# --- API Configuration ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*

# --- LLM Provider (openai | anthropic | google | ollama) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Gemini ---
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Embedding Provider (openai | huggingface | ollama) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=rag_documents

# --- Chunking Strategy (fixed | recursive | semantic) ---
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retriever (hybrid | similarity | mmr) ---
RETRIEVER_STRATEGY=hybrid
RETRIEVER_K=5
RETRIEVER_SCORE_THRESHOLD=0.3

# --- Reranker ---
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=3

# --- Redis Cache (optional) ---
REDIS_URL=redis://localhost:6379/0
CACHE_BACKEND=disk

# --- Ingestion ---
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=50
